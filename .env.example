# Environment variable reference; .env files are not loaded by the server.
# Export these variables or set them in your MCP client. NEVER commit your real token.

# Personal access token. Create one at https://app.speckle.systems/profile
# The demonstrated scopes are Projects > Core > Read (project.core.read),
# Workspaces > Core > Read, and Account > Profile > Read.
# A smaller scope set has not been tested.
SPECKLE_TOKEN=your-personal-access-token-here

# Optional. Defaults to https://app.speckle.systems.
# Set this to your own server URL if you self-host Speckle.
SPECKLE_SERVER_URL=https://app.speckle.systems
